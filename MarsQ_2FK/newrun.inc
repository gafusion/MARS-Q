C=======================================================================
C  HOW TO RUN DIFFERENT VERSIONS OF THE CODE?
C=======================================================================
C  MARS-F  : IDIAM*=0, INCKIN=0
C  MARS-Q  : NCASE=6, NITMAX=1, NSWEEP>1
C  MARS-K  : IDIAM*=0, INCKIN>0
C  MARS-2F : IDIAM*>0, INCKIN=0
C  MARS-2FK: IDIAMTE=0, IDIAMB=1 OR 3, INCKIN>0
C
C=======================================================================
C  DESCRIPTION OF NAMELIST VARIABLES: BASIC
C=======================================================================
C  NCASE  =-3,-2,-1: INTERNAL DIAGNOSTICS OF THE PAMS SOLVER
C           0: EIGENVALUE SOLVER WITH RANDOM INITIAL GUESS 
C           1: RUN THE CODE AS EIGENVALUE SOLVER USING INVERSE ITERATION METHOD,
C              RE-NORMALISING THE SOLUTION AFTER EACH ITERATION
C           2: RFA/RMP COMPUTATIONS
C           3: RUN THE CODE WITH TIME STEPPING, WHERE THE CURRENT SOURCE TERM IS A 
C              FUNCTION OF TIME (SIN-SIGNAL)
C           4: RUN THE CODE WITH TIME-STEPPING FOR FEEDBACK SIMULATION WITH
C              POSSIBLY VOLTAGE OR CURRENT SATURATION. IN THREE STEPS (NSWEEP=3): 
C              FIRST, RUN EIGENVALUE PROBLEM TO OBTAIN THE RWM EIGENFUNCTION;
C              SECONDLY, USING THE EIGENFUNCTION TO START TIME STEPPING W/O FEEDBACK;
C              THIRD, WHEN THE MODE AMPLITUDE REACHES A THRESHOLD VALUE, TURN ON FEEDBACK.
C           5: QUASILINEAR SOLVER WITH N=0 ROTATION DAMPING EXPLICITLY INCLUDED IN MHD
C           6: FULL IMPLICIT QUASILINEAR SOLVER
C           7: IMPLICIT QUASILINEAR TIME-STEPPING, BUT WITH INSTATANEOUS PLASMA RESPONSE
C           8: AN ANALYTIC TEST CASE FOR THE MOMENTUM SOLVER    
C           9: EXPLICIT QUASILINEAR SOLVER FOR N=0: RE AVALANCHE, VDE
C              WITH UNIFORM TIME STEP = 1/RE(TALPHA1)
C              TOTAL NUMBER OF STEPS = NITMAX
C              USE <THRESHOLD> TO SET UP INITIAL PERTURBATION AMPLITUDE
C          10: QUASILINEAR SOLVER FOR N=0: RE AVALANCHE, VDE
C              WITH IMPLICIT SCHEME FOR TERM ASSOCIATED WITH KVSQL(3)
C              TOTAL NUMBER OF STEPS = NSWEEP
C
C  NCOUPL = 0: OLD BC FOR MARS: B1=0 AT NV, 
C           1: B1_M = BNORM01 AT NV AT EACH ITERATION, CONVERGENCE TEST
C           2: B1_M/SUM(B1_M) = BNORM02/SUM(BNORM02) AT NV, CONVERGENCE TEST
C           3: B1_M/B2_M = BNORM03 AT NV, CONVERGENCE TEST
C           4: B1_M = BNORM01 AT NV, ONE ITERATION, CONSISTANCY TEST
C           5: B1_M/SUM(B1_M) = BNORM02/SUM(BNORM02) AT NV, ONE ITERATION, CONSISTANCY TEST
C           6: B1_M/B2_M = BNORM03 AT NV, ONE ITERATION, CONSISTANCY TEST
C          -1: GENERATING FORWARD COUPLING DATA FOR CARMA
C          -2: BACKWARD COUPLING RUN WITH POLOIDAL/NORMAL AS BC
C          -3: BACKWARD COUPLING RUN WITH TOROIDAL/NORMAL AS BC
C
C  INERT1 = .T. : INCLUDE CORIOLOS FORCE 1 IN THE MOMENTUM EQUATION 
C  INERT2 = .T. : INCLUDE CORIOLIS FORCE 2 IN THE MOMENTUM EQUATION
C  INERT3 = .T. : INCLUDE CENTRIFUGAL FORCE IN THE MOMENTUM EQUATION
C  
C  MWALL  = 0: DO NOT MOVE RESISTIVE WALLS
C           1: MOVE RESISTIVE WALLS DURING INITIAL VALUE VDE SIMULATIONS
C  IWO = 0: OLD WALL EQUATION FOR COMPLETE THIN WALL,
C        1: NEW WALL EQUATION FOR COMPLETE THIN WALL (BETTER TO USE)
C        2: THIN WALL WITH VARYING CONDUCTIVITY (SIGMAW>0 EVERYWHERE)
C        4: THIN WALL WITH POLOIDAL GAPS (SIGMAW=0 OR 1)
C
C  IVISC = 0: NO PARALLEL SOUND WAVE DAMPING
C          1: PHYSICAL MODEL WITH ALL TERMS INCLUDED
C          2: NO DISPLACEMENT TERMS IN THE DAMPING TERM, PHYSICALLY VALID AT 
C             VANISHING FLOW, OTHERWISE USE FOR NUMERICAL SMOOTHING
C  
C  <NFLAGROTA> CONTROLS LOCAL MODIFICATION OF ROTATION PROFILE NEAR FIRST 
C  RATIONAL SURFACE. VALID ONLY FOR OPTION NPROFR=4
C  NFLAGROTA = 0: NO MODIFICATION 
C              1: METHOD-I
C              2: METHOD-II
C              3: METHOD-III
C  SLEFT = LEFT RADIAL POSITION FOR MARS-F/K/Q SOLUTION
C          DEFAULT VALUE IS 0.0.
C
C  NPROFRC = 0: NO INCLUSION OF ROTC=POLOIDALLY VARYING TOROIDAL FLOW
C            1: ANALYTIC OPTION:
C            4: EXPERIMENTAL PROFILE FROM PROFROTC.IN
C  ROT_TOT = ROTE*ROT + ROTEC*ROTC
C
C  NPROFRP = 0: NO POLOIDAL ROTATION
C            1: UNIFORM POLOIDAL ROTATION
C            4: EXPERIMENTAL PROFILE FROM PROFROTP.IN
C
C  KJRER   = 1: INCLUDE N=0 ROSENBLUTH AVALANCHE RE MODEL,
C               WITH SEED RE CURRENT = JRE_SEED 
C            2: SAME AS OPTION 1, BUT EXCLUDE LINEAR JRE TERM FROM OHM'S LAW
C            3: SAME AS OPTION 1, BUT EXCLUDE QUADRATIC JRE TERM FROM OHM'S LAW
C            4: SAME AS OPTION 1, BUT EXCLUDE BOTH JRE TERMS FROM OHM'S LAW
C            5: INCLUDE CONVECTION EQUATION FOR N.NE.0 PERTURBED JRE, 
C               FOR FLUID MHD-RE HYBRID MODEL
C            6: INCLUDE CONVECTION EQUATION AND EXB DRIFT FOR N.NE.0 PERTURBED JRE, 
C               FOR FLUID MHD-RE HYBRID MODEL
C               USE JRE_EQFRAC TO SCAN THE RE EFFECT
C  KJRE_INIT = 1: CONSTANT PROFILE FOR JRE SEED
C              2: STRONGLY PEAKED PROFILE FOR JRE SEED
C              3: HOLLOW PROFILE FOR JRE SEED
C  KVSQLIN = .T.: INCLUDE QUASI_LINEAR MHD TERMS FOR N=0 
C  KVSQL(1:7) = .T.: INCLUDE INDIVIDUAL QUADRATIC TERMS FOR N=0 VS STUDY
C                    NOT IN ACTION IF KVSQLIN=.F.
C  KVSQL(8)   = .T.: INCLUDE FIRST LINEAR TERMS FROM RHS OF EQ. FOR Q, JUST FOR TEST
C  RE_RP_FAC = MULTIPLIER IN ROSENBLUTH-PUTVINSKI FORMULA
C  NPROFNF   = 0: CONSTANT 1
C              1: (DEFAULT) ANALYTIC FORMULA FOR NEOCLASSICAL FUNCTION
C              4: NUMERICAL FUNCTION READ FROM <PROFNEOFUNC.IN>
C  JRE_EQFRAC = JRE_EQ_PARA/J_EQ_PARA BEING A CONSTANT BETWEEN [0,1] WHEN KJRER=5
C               NUMERICAL COEFFICEINT WHEN KJRER=6
C               =0.0: RECOVERS FLUID RESULT
C               =1.0: RECOVERS HYBRID RESULT
C  JRE_DIFF   = DIFFUSION COEFFICIENT FOR JRE-EQUATION WHEN KJRER=5
C  JRE_EXB    = NUMERICAL COEFFICIENT BEFORE JRE EXB TERM. 
C               DEFAULT=1.0
C               RECOVERS MODEL-I IF JRE_EXB=0.0
C  V1U_DIFF   = DIFFUSION COEFFICIENT FOR V1U-EQUATION WHEN RNTOR=0
C  NPROFZ     = ZEFF PROFILE
C               0: =ZEFF0 AS CONSTANT
C               4: READ FROM PROFZEFF.IN, ZEFF0 INACTIVE

C=======================================================================
C  DESCRIPTION OF NAMELIST VARIABLES: FEEDBACK
C=======================================================================
C  INCFEED = 0: NO INCLUDE FEEDBACK CONTROL;
C            1: Br-FEEDBACk WITH RADIAL SENSORS: FLUX;
C           11: Br-FEEDBACK WITH RADIAL SENSORS: POINT-WISE FIELD; 
C           12: Br-FEEDBACK WITH RADIAL SENSORS: POINT-WISE FIELD,
C                  WITHOUT PLASMA; 
C            2: MUTUAL INDUCTANCE CALCULATION FOR Br-SENSOR,
C            3: FEEDBACK WITH POLOIDAL SENSORS,
C            9: FEEDBACK WITH POLOIDAL SENSORS, WITHOUT PLASMA
C            4: MUTUAL INDUCTANCE RMFS=B1/FEEDI;
C            5: FEEDBACK WITH B3 SENSORED SIGNAL,
C 	          6: CALCULATIONS WITH ONLY RW CURRENT,
C            8: RFA CALCULATION
C           10: MUTUAL INDUCTANCE ASSUMING PLASMA AS RIGID IDEAL
C               CONDUCTOR 
C             : TO CALCULATE WALL DECAY TIME, ONE NEEDS TO CHOOSE WALL 
C               POSITION, SET INCFEED=2 AND FEEDI=0,
C           20: FOR COMPUTING TEARING INDEX DELTA'
C               <KRATSURF> SPECIFIES K-TH NUMBER OF RATIONAL SURFACE 
C           21: PLASMA RESPONSE WITH GIVING BC FOR B1 AT NTP1
C           22: VACUUM RESPONSE WITH GIVING BC FOR B1 AT NTP1
C               
C  IDYNAM = 0: NO INCLUSION OF FEEDBACK AMPLIFIER DYNAMIC,
C           1: INCLUDE FEEDBACK AMPLIFIER DYNAMIC, FOR NORMAL CONDUCTORS
C           2: VOLTAGE CONTROL FOR SUPERCONDUCTING ACTIVE COILS
C           3: COMBINED WITH INCFEED=8, TO ELIMINATE |X|-LIKE EVEN-PARITY 
C              NUMERICALLY SPURIOUS SOLUTION INSIDE THE RESISTIVE LAYERS
C              BY FORCING ODD-PARITY SOLUTION
C           4: COMBINED WITH INCFEED=8, TO ELIMINATE |X|-LIKE EVEN-PARITY 
C              NUMERICALLY SPURIOUS SOLUTION INSIDE THE RESISTIVE LAYERS
C              BY FORCING CONTINUITY OF RADIAL DERIVATIVE OF V1
C              4 IS THE BETTER OPTION THAN 3.
C
C  IPSIF = 0: OLD WAY TO CALCULATE 'PSIF' USING H-WEIGHT FUNCTION,
C          1: NEW WAY TO CALCULATE 'PSIF' USING JCHI-WEIGHT FUNCTION;
C 
C  TAUF  = FEEDBACK L/R TIME,
C
C  GAIN = GAINA*EXP(GAINP*PI*CI) IS SPECIFIED FOR EACH COIL ALONG
C         THE POLOIDAL ANGLE
C
C  KKF   --- PROFILE-PARAMETER OF FEEDBACK CURRENT DENSITY,
C       = 0: USING HEVISAID-FUNCTION FOR J3U REPRESENTATION,
C       =-1: USING GAUSS-FUNCTION FOR J3U REPRESENTATION,
C            J2U(M) CALCULATED ANALITICALLY BY INTEGRATING OVER [-INF INF].
C       =-2: READ EXTERNAL CURRENT J2U(M) FROM FILE <CURHARMO>
C       =-3: READ BN(M) FROM <INPUT_BNM> AT ONE VACUUM SURFACE, 
C            COMPUTE EQUIVALENT SURFACE CURRENT AT SURFACE IFEED, 
C            AND SAVE TO <CURHARMO.OUT>   
C       > 0: USING GAUSS-FUNCTION OF ORDER OF KKF FOR J3U REPRESENTATION,
C            J2U(M) CALCULATED NUMERICALLY BY INTEGRATING OVER [-PI PI],
C
C  FCCHI --- CENTER OF EACH FEEDBACK COIL ALONG POLOIDAL ANGLE
C  FWCHI --- POLOIDAL ANGULAR EXTENT OF EACH FEEDBACK COIL;
C  SCCHI --- CENTER OF EACH SENSOR COIL ALONG POLOIDAL ANGLE
C  SWCHI --- POLOIDAL ANGULAR EXTENT OF EACH SENSOR COIL;
C  BTCHI --- ANGULAR WIDTH OF THE TOROIDAL LEGS OF EACH FEEDBACK COIL;
C  FCCHI,FWCHI,SCCHI,SWCHI, BTCHI ARE NORMALIZED BY 'PI';
C                  
C  0 <= BTCHI <= FWCHI/2;
C
C  MAGNETIC FLUX THROUGH LOOPS IS CALCULATED USING CURRENT DISTRIBUTION;
c
C  RL0   --- SELF-INDUCTANCE OF ACTIVE COIL,
C  IFEED --- FEEDBACK COILS POSITION,
C  ISENS --- SENSOR COILS POSITION,
C            |ISENS(0) - IFEED| <= 1, 
C  FEEDI --- POLOIDAL ARRAY CURRENT AMPLITUDE IN FEEDBACK COILS,
C  FEEDIT--- TOROIDAL ARRAY CURRENT AMPLITUDE IN FEEDBACK COILS,
C
C  FNUP  --- COEFFICIENT OF PROPORTIONAL GAIN FOR SENSOR J
C  FNUD  --- COEFFICIENT OF DERIVATIVE GAIN FOR SENSOR J
C
C  NCOIL  = NUMBER OF ACTIVE COILS ALONG POLOIDAL ANGLE (1...NCOIL)
C  NSENS  = NUMBER OF SENSOR COILS ALONG MINOR RADIUS (0...NSENS)
C  NCOILT = NUMBER OF ACTIVE COILS ALONG TOROIDAL ANGLE (1...NCOILT)
C  NSENST = NUMBER OF SENSOR COILS ALONG TOROIDAL ANGLE (1...NSENST)
C
C  KREADECA = 0: GENERATE AND WRITE MATRIX IN SUBROUTINE EQUIV_CURRENT TO <ECA.OUT>
C             1: READ MATRIX FROM <ECA>, COPIED FROM <ECA.OUT>
C             NOTE SINCE THE ECA MATRIX IS BASED ON BIOT-SAVART LAW, 
C             IT TAKES LONG TIME TO COMPUTE
C  
C  DTRAMPUI = TIME (IN TAUA UNIT) TO (LINEARLY) RAMP UP RMP CURRENT FROM 0 TO FEEDI, USED
C             IN COMBINATION WITH (NCASE=6,INCFEED=4|8)
C             IN ACTION ONLY IF KCOILCURR=2
C
C  KCOILCURR = 0: RESERVED OPTION FOR FUTURE USE
C              1: ON-OFF TRANSITION OF COIL CURRENT FROM 0 TO FEEDI AT TIME=0
C              2: LINEAR RAMP UP OF COIL CURRENT, USING DTRAMPUI
C              3: AC-CURRENT VARIATION MODEL FOR NCASE=3
C              4: READ IN EXPERIMENTAL COIL CURRENT TIME TRACE FOR FEEDI(1)
C                 ASSUMING STANDING WAVE FOR THE COIL CURRENT
C                 BOTH TIME AND COIL CURRENT AMPLITUDE ARE IN MARS-Q UNITS
C                 THE DATA ARE READ FROM FILE <COILCURR.IN>
C              5: READ IN EXPERIMENTAL COIL CURRENT TIME TRACE FOR FEEDI(1)
C                 ASSUMING TRAVELLING WAVE FOR THE COIL CURRENT
C                 BOTH TIME AND COIL CURRENT AMPLITUDE ARE IN MARS-Q UNITS
C                 THE DATA ARE READ FROM FILE <COILCURR.IN>
C                 SEPARATE DATA STORED FOR EACH ROW OF COILS ==> 
C                 IN TOTAL 2*NCOIL+1 COLUMNS IN <COILCURR.IN>
C  RAN_STD = STANDARD DEVIATION OF THE INPUT GAUSSIAN NOISE FOR THE FEEDBACK
C            SENSOR SIGNAL, IN MARS-F UNITS
C          <=0.0 : NO NOISE
C          >0.0  : WITH NOISE   
C
C  VFMAX   > 0.0 : THRESHOLD FOR FEEDBACK VOLTAGE/CURRENT SATURATION 
C          < 0.0 : NO SATURATION IS APPLIED (DEFAULT) 
C
C  FINIC = IN/IC = FRACTION OF N-TH COMPONENT OF RMP COIL CURRENT OUT OF
C                  THE ACTUAL COIL CURRENT. 
C                  USED ONLY FOR OUTPUT <BPLASMA_MARSF*>

C=======================================================================
C  DESCRIPTION OF NAMELIST VARIABLES: KINETIC
C=======================================================================
C INCKIN = 0: NO KINETIC CONTRIBUTIONS
C          1: WITH KINETIC CONTRIBUTIONS
C          2: KINETIC DAMPING AT CGL LIMIT                            
C IPERTURB  = 0: NON-PERTURBATIVE APPROACH FOR KINETIC INCLUSION      
C             1: PERTURBATIVE APPROACH FOR KINETIC INCLUSION          
C             2: PERTURBATIVE APPROACH FOR KINETIC INCLUSION,         
C                ROTATION EXCLUDED IN THE FLUID PART                  
C KENORM = 1: NORMALIZE ENERGY BY TOTAL PLASMA INERTIA ENERGY         
C          2: NORMALIZE ENERGY BY INERTIA ENERGY ASSOCIATED WITH X1   
C KEFORM = 0: DO NOT COMPUTE ENERGY
C          1: USE RAW FORM TO COMPUTE ALL ENERGY TERMS DW*
C          2: USE QUADRATIC FORM TO COMPUTE ENERGY TERMS FOR: 
C             DWPPARA,DWPPERP,DWP,DWJ
C             THIS LEADS TO FULL QUADRATIC FORM FOR PERTURBED ENERGY INSIDE PLASMA
C          NOTE: 1) TWO SHOULD GIVE THE SAME NET DW IF CTEDGE=1 AND 
C                   THE CORRESPONDING SURFACE TERMS VANISH
C                2) THE SUM OF ALL DW* VANISHES ONLY FOR KEFORM=1    
C NNSCAN   = 0: SAVE EP DISTRIBUTION DATA, FOR IF0TYPE=3              
C            1: READ SAVED EP DISTRIBUTION DATA, FOR IF0TYPE=3         
C ALPHAD   = [0,1]: OVERALL KINETIC FRACTION, CONTROLLING BOTH        
C                   ADIABATIC AND NON-ADIABATIC CONTRIBUTIONS FOR     
C                   INCKIN=1; AND CONTROLLING ONLY NON-ADIABATIC      
C                   CONTRIBUTION FOR INCKIN=2(CGL LIMIT)
C ALPHAH   = [0,1]: MULTIPLIER FOR ALL EP'S PRESSURE FRACTION DATA READ
C                   FROM <PROFPA.IN>
C INUTYPE  =  0: COLLISIONALITY INDEPENDENT OF ENERGY (USE ANALYTICAL 
C                FORMULATION)                                         
C          = -1: NUMERICAL INTEGRATION OF COLLISIONALITY INDEPENDENT  
C                OF ENERY (IT RECOVERS THE RESULT WHEN ISNUTYPE = 0)  
C          =  1: KROOK COLLISIONALITY                                 
C                NU_EFF*E^-1.5*[1+L^2/4] FOR TRAPPED PARTICLE         
C                NU_EFF*E^-1.5*[1+(L+M)^2/4] FOR PASSING PARTICLES    
C                PRECESSION DRIFT FREQUENCY IS INCLUDED IN THE        
C                BOUNCE RESONANT OPERATOR
C          =  2: KROOK COLLISIONALITY                                 
C                NU_EFF*E^-1.5 FOR BOTH TRAPPED AND PASSING PARTICLES 
C                PRECESSION DRIFT FREQUENCY IS INCLUDED IN THE        
C                BOUNCE RESONANT OPERATOR
C                                                                     
C KFASTRUN    = 0: NUMERICAL INTEGRATION OVER PARTICLE ENERGY FOR ALL 
C                  PARTICLE DISTRIBUTION TYPES (INCLUDING THERMALS)    
C               1: ANALYTIC INTEGRATION FOR CERTAIN CASES (ESSENTIALLY
C                  OLD MARS-K IMPLEMENTATION)                         
C IFOWPSI0    = 1: THE \HAT\PSI0 APPROACH FOR FOW CORRECTION OF       
C                  PASSING PARTICLES
C               2: THE \TILDE\PSI0 APPROACH FOR FOW CORRECTION OF     
C                  PASSING PARTICLES
C NSPECIES    = THE LENGTH OF ALL ARRAYS (OF PARTICLE SPECIES)        
C               DEFINED BELOW                                         
C S0TYPE4     = AMPLITUDE OF RADIAL PROFILE STYPE4 FOR IF0TYPE=4      
C R0TYPE4     = AMPLITUDE OF RADIAL PROFILE RTYPE4 FOR IF0TYPE=4      
C                                                                     
C ISPECIES_F0 = IF0TYPE =                                         
C               0: MAXWELLIAN                                             
C               1: ISOTROPIC SLOWING DOWN MODEL   (OLD KFASTION=1)        
C               2: ISOTROPIC ALPHA-PARTICLE MODEL (OLD KFASTION=2)        
C               3: ANISOTROPIC ITER BEAM MODEL    (OLD KFASTION=3)        
C                  ADDITIONAL INPUT: KNBI,ZZETA0,DZETA0                       
C               4: ANISOTROPIC ICRH MODEL                                 
C                  ADDITIONAL INPUT: S0TYPE4*PROFILE,R0TYPE0*PROFILE,     
C                  HHTYPE4C=[0,1], KSMTYPE4=MODEL NUMBER FOR ASYMETRY FACTOR S
C               5: RUNAWAY ELECTRON EQUILIBRIUM DISTRIBUTION MODEL,
C                  ASSUMING INDEPENDENT DISTRIBUTIONS ALONG MINOR RADIUS, 
C                  PARTICLE PITCH AND ENERGY
C                  FOR EXPERIMENTAL INPUT (NPROFK=4), READ FILES:
C                  PROFDA.IN  = RE DENSITY NORMALIZED BY THERMAL ELECTRON DENSITY
C                  PROFDA.IN  = RE PRESSURE NORMALIZED BY THERMAL PRESSURE
C                  PROFREL.IN = RE PITCH-ANGLE DISTRIBUTION WITH PEAK VALUE=1
C                  PROFREE.IN = RE ENERGY DISTRIBUTION WITH PEAK VALUE=1
C               6: RE EQUILIBRIUM DISTRIBUTION MODEL (ALEYNIKOV PRL15)
C                  RE EQ CURRENT PROFILE = SURF_AVERAGED PARALLEL EQ CURRENT
C FOR IF0TYPE=3, THE FOLLOWING OPTIONS ARE AVAILABLE                                                                     
C   KNBI  = 0: NORMAL NBI INJECTION MODEL: ZZETA0=0
C           2: SYMMETRIC NBI INJECTIONS (I.E. BOTH CO- AND COUNTER-INJECTIONS)
C          11: CO-TANGENTIAL INJECTION MODEL BY GORELENKOV
C          12: CO-TANGENTIAL INJECTION MODEL ~ KNBI=11, BUT ALWAYS CONTINUOUS 
C          13: CO-TANGENTIAL INJECTION MODEL, ALWAYS CONTINUOUS AND POSITIVE 
C          31: COUNTER-TANGENTIAL INJECTION MODEL BY GORELENKOV
C          32: COUNTER-TANGENTIAL INJECTION MODEL ~ KNBI=11, BUT ALWAYS CONTINUOUS 
C          33: COUNTER-TANGENTIAL INJECTION MODEL, ALWAYS CONTINUOUS AND POSITIVE 
C
C ESPECIES_Z  = {CHARGE NUMBER OF PARTICLE}                           
C EPSECIES_M  = {MASS NUMBER OF PARTICLE, =1 FOR PROTON}              
C                                                                     
C PSPECIES_AP = {FACTOR OF ADIABATIC CONTRIBUTION FROM PASSING        
C                PARTICLE, VARYING BETWEEN 0 AND 1}                   
C               APPLY TO KI-TERMS, OR (XI DOT GRAD P)-TERMS           
C PSPECIES_AT = {FACTOR OF ADIABATIC CONTRIBUTION FROM TRAPPED        
C                PARTICLE, VARYING BETWEEN 0 AND 1}                   
C               APPLY TO KI-TERMS, OR THE EXTRA TERM IN ISOTROPIC     
C               SLOWING DOWN DISTRIBUTION                             
C PSPECIES_NP = {FACTOR OF NON-ADIABATIC TRANSIT RESONANCE CONTRIBUTIO 
C                FROM PASSING PARTICLE, VARYING BETWEEN 0 AND 1}      
C               APPLY TO KI-TERMS                                     
C PSPECIES_NTB= {FACTOR OF NON-ADIABATIC BOUNCE RESONANCE CONTRIBUTION
C                FROM TRAPPED PARTICLE, VARYING BETWEEN 0 AND 1}      
C               APPLY TO KI-TERMS                                     
C PSPECIES_NTD= {FACTOR OF NON-ADIABATIC TOROIDAL PRECESSION DRIFT    
C                RESONANCE CONTRIBUTION FROM TRAPPED PARTICLE,        
C                VARYING BETWEEN 0 AND 1}                             
C               APPLY TO KI-TERMS                                     
C PSPECIES_NDB= {FACTOR OF NON_ADIABATIC CONTRIBUTION DUE TO
C                RESONANCE BETWEEN PECESSION AND BOUNCE FREQUENCIES,
C                ONLY FOR TRAPPED PARTICLES,
C                VARYING BETWEEN 0 AND 1}                             
C               APPLY TO KI-TERMS                                     
C PSPECIES_FOWP={FACTOR OF FIRST ORDER FOW CORRECTION FOR PASSING     
C                PARTICLES, TO BOTH ADIABATIC AND NON-ADIABATIC       
C                CONTRIBUTIONS, VARYING BETWEEN 0 AND 1}              
C               APPLY TO KI-TERMS                                     
C PSPECIES_FOWT={FACTOR OF FIRST ORDER FOW CORRECTION FOR TRAPPED     
C                PARTICLES, TO BOTH ADIABATIC AND NON-ADIABATIC       
C                CONTRIBUTIONS, VARYING BETWEEN 0 AND 1}              
C               APPLY TO KI-TERMS
C KNUSPECIES   = 0: LEGACY GNUI/GNUE COLLISION PROFILES (DEFAULT)
C              = 1: NUEFFSA(KP) IS A CONSTANT PHYSICAL RATE [S^-1]
C                   FOR EVERY MAXWELLIAN SPECIES, IN NATIVE I,E,... ORDER.
C                   CONVERTED TO NUEFFSA*ZTAUA0 BEFORE NUMODEL GEOMETRY;
C                   INUTYPE ENERGY/HARMONIC DEPENDENCE IS UNCHANGED.
C                   ALL REQUIRED THERMAL RATES MUST BE FINITE AND >=0.
C                   NUMERICAL INUTYPE!=0 REQUIRES STRICTLY POSITIVE RATES.
C                   REQUIRES THE NATIVE INCKIN=1,KNTV=21 NTV MODEL.
C                   THIS INPUT DOES NOT COMPUTE COLLISION BACKGROUNDS.
C                   WITH >2 SPECIES ONLY NEXPV=0,NPROFIE=0 IS SUPPORTED;
C                   USE NPROFK DENSITY/PRESSURE FRACTIONS AND VERIFY
C                   THE RESULTING ESPECIES_DEN/PRE/TEM FOR ALL SPECIES.
C                   EXPERIMENTAL MIXTURE TEMPERATURE INPUT IS REJECTED.
C                   THERMAL_COLLISION_RATES.OUT RECORDS THE INPUT AND
C                   BASE-NORMALIZED RATES; THE LEGACY TWO-SPECIES NU*
C                   DIAGNOSTIC IS EXPLICITLY OMITTED IN THIS MODE.
C NUMODEL      = 0: MARS-Q COLLISIONALITY MODEL
C IGAMMADIVV   = 0: P=PEQ IN THE TERM GAMMA*P*DIV(V)
C                1: P=SUM OF PRESSURES FROM PARTICLE SPECIES WITHOUT NON_ADIABATIC 
C                   KINETIC CONTRIBUTIONS
C EP_DENF0     = AMPLITUDE OF EP'S DENSITY FRACTION,  VALID FOR NPROFK=0,1  
C EP_PREF0     = AMPLITUDE OF EP'S PRESSURE FRACTION, VALID FOR NPROFK=0,1  
C
C INCDPHI      = 0: MARS-K RUNS WITHOUT PERTURBED ELECTROSTATIC POTENTIAL
C              = 1: INCLUDE PERTURBED ELECTROSTATIC POTENTIAL DPHI AS X-VARIABLE
C                   VALID ONLY WITH KFASTRUN=0 AND (V2XKEY=1 OR V2XKEY=3)
C
C KEPSALPHA    = 0: EPSALPHA AS CALCULATED BASED ON PROFDA AND PROFPA
C              = 1: EPSALPHA AVERAGED TO CONSTANT AFTER CALCULATION 
C
C=======================================================================
C  DESCRIPTION OF NAMELIST VARIABLES: QLIN
C=======================================================================
C IT_BC = 0 : FREE BC (NEWMANN) FOR DELTA_OMEGA AT PLASMA BOUNDARY
C         2 : DIRICHRIT BC DELTA_OMEGA=0 AT PLASMA BOUNDARY
C ID_BC = 0 : FREE BC (NEWMANN) FOR DENSITY CHANGE AT PLASMA BOUNDARY
C         2 : DIRICHRIT BC FOR DENSITY CHANGE AT PLASMA BOUNDARY
C ITSATURAT = 0: DO NOTHING
C             1: FORCE ROTATION FREQUENCY TO BE NO LESS THAN 1E-3
C NPROFVD : CHOICE KEY FOR TOROIDAL MOMENTUM DIFFUSION PROFILE
C NPROFDD : CHOICE KEY FOR RADIAL PARTICLE DIFFUSION PROFILE
C TCHIM0: TOROIDAL MOMENTUM DIFFUSION AMPLITUDE
C TCHID0: RADIAL PARTICLE DIFFUSION AMPLITUDE
C CDMHD : MULTILIER BEFORE MHD INDUCED PARTICLE TRANSPORT TERM
C CDNTV : MULTILIER BEFORE NTV INDUCED PARTICLE TRANSPORT TERM
C CDERGO : MULTILIER BEFORE STOCHASTIC INDUCED PARTICLE TRANSPORT TERM
C CTERGO : MULTILIER BEFORE STOCHASTIC INDUCED TORQUE
C ALPHACOL: DETERMINE EDGE COLLISIONAL REGIME TO COMPUTE E STOCHASTIC
C         = (0,1): 0 = COLLISIONLESS LIMIT, 1 = COLLISIONAL LIMIT
C
C KEYTORQ = 1: SAVE INPUT DATA FOR COMPUTING JXB TORQUE, TO <DATATORQJXB.OUT>,
C              NTV TORQUE TO <DATATORQNTV.OUT>, REY TORQUE TO <DATATORQREY.OUT>
C           2: READ INPUT DATA FOR COMPUTING CROSS-COUPLING TERMS OF 
C              TORQUE, FROM TWO FILES <DATATORQ***_A> AND <DATATORQ***_B>
C KNTV = 10,11: COMPUTE NTV TORQUE DENSITY BASED ON SHAING'S FORMULA (SUN'S IMPLEMENTATION)
C        20,21: COMPUTE NTV TORQUE DENSITY AS IM(DWK) BY MARS-K, NEED TO SET ODWKCOM=.T.
C        10,20: COMPUTE NTV TORQUE DENSITY AS SPECIFIED BY ZCHARGE OR BY PSPECIES_*
C        11,21: COMPUTE SEPARATE NTV TORQUE DENSITIES FOR IONS AND ELECTRONS
C        20   : NEED TO SPECIFY ZCHARGE IF PARTICLE FLUX TO BE COMPUTED
C
C NDENEQ = 1: CHANGE EQUILIBRIUM DENSITY DURING DENSITY PUMPOUT RUNS
C          0: KEEP EQUILIRIUM DENSITY
C
C KSOLTEST = 1: CHECK WHETHER SOLUTION (X,Y) SATISFIES MOMENTUM BALANCE EQATION

C=======================================================================
C  DESCRIPTION OF NAMELIST VARIABLES: NUMERIC
C  THESE ARE VARIABLES WHOSE VALUE SHOULD NOT CHANGES PHYSICAL RESULTS
C=======================================================================
C NCONVB1   = 0: NORMAL RUNS
C             1: COMPUTE PANGLE_EQAC/PANGLE_PEST AT ALL RATIONAL SURFACES,
C                AND SAVE DATA TO FILE "PANGLE" (MUST SET NCONVCS=0 FOR PEST
C                MESH)
C             2: READ DATA FILES "PANGLE_EQAC" AND "PANGLE_PEST",
C                AND CONVERT POLOIDAL HARMONICS OF B1 FROM EQAC TO PEST
C                WITH RESULTS PRINTED IN LOG_MARS (TPSIM) OR "TIMEEVOL"
C NCONVCS   = 1: AFTER READING OUT*MAR DATA FROM CHEASE, CREATE NEW COORDINATE 
C                SYSTEM (S,THETA,PHI), WITH THETA BEING GEOMETRIC ANGLE
C                IN BOTH PLASMA AND VACUUM. THIS GUARANTEES THE CONTINUITY
C                OF ALL METRICS ELEMENTS THROUGH THE PLASMA-VACUUM INTERFACE.
C NVACJ = 0: OLD VACUUM AND WALL+COIL EQUATIONS FOR RNTOR.NEQ.0
C            GOOD FOR STABILITY COMPUTATIONS
C         1: NEW VACUUM AND WALL+COIL EQUATIONS FOR RNTOR.NEQ.0
C            MULTIPLIED BY JACOBIAN
C            GOOD WHEN COMPUTATIONAL DOMAIN EXTENDS TO R<0, AND
C            FOR RESPONSE COMPUTATION
C IPDIVB = 0: DIV B=0 NOT DIRECTLY USED INSIDE PLASMA
C          1: DIV B=0 REPLACES EQUATION FOR B3 INSIDE PLASMA (FOR N.NE.0)
C          2: DIV B=0 REPLACES EQUATION FOR B2 INSIDE PLASMA (FOR N.EQ.0)
C
C V2XKEY   =  0: PERTURBED VELOCITY IS USED IN KINETIC PRESSURE       
C                PERTURBED VELOCITY IS USED IN FLUID PRESSURE         
C          =  1: DISPLACEMENT IS USED IN KINETIC PRESSURE             
C                PERTURBED VELOCITY IS USED IN FLUID PRESSURE         
C          =  2: PERTURBED VELOCITY IS USED IN THE KINETIC PRESSURE   
C                DISPLACEMENT IS USED IN FLUID PRESSURE               
C          =  3: DISPLACEMENT IS USED IN KINETIC PRESSURE             
C                DISPLACEMENT IS USED IN FLUID PRESSURE               
C NADAPS = MAX. NUMBER OF ADAPTIVE MESH RE-GENERATION PER PAMS CALL
C          0: NO ADAPTIVE MESH
C          2: A GOOD CHOICE                                                                     
C ADAPSOPT = OPTION OF GENERATING ADAPTIVE MESH
C          0: LSODE ADAPTIVE INTEGRATION MESH 
C          1: ARTIFICIAL GRID PACKING (DEFAULLT)
C KADAPS = CONTROL WHETHER NEW MESH (SAVED VIA PROFEQ.OUT) SHOULD 
C          BE READ FROM PREVIOUS RUN
C          0: DO NOT READ MESH FROM PREVIOUS RUN
C          1: READ NEW MESH FROM PREVIOUS RUN
C DELRATS= SET KI-CONTRIBUTION VANISHING NEAR ALL RATIONAL SURFACES
C          |S-S_RAT|<DELRATS/Q; 
C        = 0.0: WITHOUT THE ABOVE ACTION
C NLAMK  = MAXIMAL SIZE OF PARTICLE PITCH ANGLE MESH
C NLAMIN = MINIMAL SIZE OF PARTICLE PITCH ANGLE MESH
C NEPK   = MAXIMAL SIZE OF PARTICLE ENERGY MESH
C NKL0   = SET LIMITS FOR BOUNCE/TRANSIT HARMONICS = [-NKL0+M1,NKL0+M2]
C NCHI0  = POLOIDAL ANGLE MESH SIZE IN KINETIC COMPUTATIONS
C NKSMOOTHB = NUMBER OF POLOIDAL HARMONICS FOR SMOOTHING FIELD AMPLITUDE B
C             IN KINETIC COMPUTATIONS   
C NKSMOOTHR = NUMBER OF APPLIED DIFUSSIION OPEARTION CYCLES FOR SMOOTHING
C             RADIAL PROFILES OF EQUILIBRIUM KINETIC QUANTITIES 
C NKSINGULAR = 1: ANALYTIC EXTRACTION OF SINGULARITIES IN INTEGRATION OVER 
C                 PARTICLE PITCH ANGLE SPACE (DEFAULT)
C              0: REMOVE ABOVE OPTION
C NOTE:  A GOOD CHECK OF THE ACCURACY OF THE ABOVE NUMERICAL PARAMETERS FOR
C        THE DRIFT KINETIC OPTION IS TO RUN THE PERTURBATIVE APPROACH WITH
C        (IPERTURB=2,GAMMA=0,TTCCONV0=1,TTCPARA0=0,TTCPERP0=0,NSPECIES=2)
C        TO SEE WHETHER THE KINETIC PROCEDURE (KFASTRUN=0) CAN RE_PRODUCE
C        THE FLUID PERTURBED PRESSURE, WHEN ONLY THE ADIABATIC CONTRIBUTIONS
C        OF THERMAL IONS AND ELECTRONS ARE INCLUDED. 
C NDNTR : NUMBER OF RADIAL POINTS NEAR MAGNETIC AXIS, WHERE DENSITY TRANSPORT TERMS
C         ARE CONSTANT 
C NRESR > NFIT : RESISTIVITY SMOOTHLY APPROACHES ZERO AT PLASMA EDGE OVER 
C                LAST NRESR RADIAL POINTS 
C       = 0    : TRUE SPITZER PROFILE UP TO PLASMA EDGE
C       =-1    : CAP EDGE RESISTIVITY UP TO ETA*100
C
C K_BC_N0 = 10,11,12,13 : FIXED BC ON-AXIS FOR N=0 J2U&J3U
C           20,21,22,23 : FREE  BC ON-AXIS FOR N=0 J2U&J3U
C           30,31,32,33 : ROBIN BC ON-AXIS FOR N=0 J2U&J3U
C           10,20,30 : NO    BC AT EDGE FOR N=0 J2U&J3U
C           11,21,31 : FIXED BC AT EDGE FOR N=0 J2U&J3U
C           12,22,32 : FREE  BC AT EDGE FOR N=0 J2U&J3U
C           13,23,33 : ROBIN BC AT EDGE FOR N=0 J2U&J3U
C           ALL K_BC_N0 OPTIONS APPLY ONLY FOR INCFEED=8
C           SET K_BC_N0=0 FOR INCFEED=4

C=======================================================================
C  DESCRIPTION OF NAMELIST VARIABLES: OUTOPT

C=======================================================================
C ODWKCOM = .TRUE.: OUTPUT DWK ENERGY COMPONENTS DUE TO DIFFERENT EFFECT
C                   IN DETAIL. FOR NON_PERTURBATIVE APPROACH, WORKS ONLY
C                   IN COMBINATION WITH (V2XKEY=1 OR 3)
C KISLAND = 1: SINGLE N-FIELD PERTURBATION EXP(I*N*PHI) FOR COMPUTING ISLAND WIDTH
C              NEED TO RUN WITH NCONVB1=2
C           2: BOTH +N & -N FIELD PERTURBATION COS(I*N*PHI) FOR ISLAND WIDTH
C              NEED TO RUN WITH NCONVB1=2
C ODJPHI > 0.0: COMPUTE B-FIELD PRODUCED BY A CURRENT FILAMENT INSIDE THE PLASMA
C               WITH NET FILAMENT CURRENT AMPLITUDE = ODJPHI, LOCATED AT (JSOUT,OCHI0), 
C               AND WITH OUTPUT B-FIELD STORED IN <BFILAMENT.OUT> IN 3D SPACE (R,Z,PHI),
C               OF DIMENSIONS (NTOT,NCHI+1,NOPP),RESPECTIVELY
C        = 0.0: DO NOT PERFORM SUCH COMPUTATION 
C NPICK = NUMBER OF PICK-UP COILS IN VACUUM REGION, WITH (S,CHI) LOCATIONS SPECIFIED BY 
C         ARRAYS IPICK(1:NPICK) AND CPICK(1:NPICK). NOTE THAT: 
C         IPICK SPECIFIES HALF-INTEGER RADIAL MESH POINT NUMBER IN THE VACUUM.   
C         CPICK NORMALIZED BY PI, WITH RANGE OF VALUES IN [-1.0,1.0]
C
C OSWEEP = NUMBER OF TIME STEPS FOR SAVING OUTPUT FIELD DATA DURING MARS-Q RUNS
C        <0 OR >NSWEEP : DO NOT SAVE DATA
C NREORBIT > 0: TRACE DRIFT ORBITS OF NREORBIT-NUMBER OF RE PARTICLES, 
C               USING MARS-Q COMPUTED STEADY STATE E-FIELD AND B_FIELD.
C               INITIAL CONDITIONS (POSITION+MOMENT) TO BE HARD_CODED AND CONTROLED BY KRE_INIT
C          = 0: NO RE ORBIT TRACING
C        
C               THE FOLLOWING ARE ADDITIONAL CONTROL PARAMETERS:
C   KRE_INIT=1-8 : CONROL CHOICE OF INITIAL CONDITIONS FOR RE TRACING
C                  CHECK REORBIT.F:RE_INIT_COND FOR DETAILS
C                  VARIOUS UNIFORM DISTRIBUTIONS
C              9 : READ IN FIDIST.IN WITH 4D-DISTRIBUTION
C             19 : READ IN FIDIST.IN WITH 5D-DISTRIBUTION
C             10 : GENERIC OPTION FOR INITIAL CONDITION:
C                  ALWAYS CONSIDER KRE_SIGMA0=+1 AND -1 
C             20 : LAUNCH PARTICLES FROM DIVERTOR PLATE AS SPECIFIED BY (R,Z) 
C                  COORDINATES (IN METER) FROM INPUT FILE LIMITER_GEOM.IN
C                  THIS OPTION IS MOSTLY USEFUL FOR FIELD LINE TRACING 
C             30 : RE-START REORBIT TRACING
C                  READ FILE RE_LOSS.IN WITH THE SAME FORMAT AS RE_LOSS.OUT
C     KRE1 = 1 : FIRST PARAMETER TO VARY IS RE_S0=[RE_S0MIN,RE_S0MAX]
C            2 : FIRST PARAMETER TO VARY IS RE_CHI0
C            3 : FIRST PARAMETER TO VARY IS RE_PHI0
C            4 : FIRST PARAMETER TO VARY IS RE_P0
C            5 : FIRST PARAMETER TO VARY IS RE_LAMBDA0
C     KRE2 = 1 : SECOND PARAMETER TO VARY IS RE_S0=[RE_S0MIN,RE_S0MAX]
C            2 : SECOND PARAMETER TO VARY IS RE_CHI0
C            3 : SECOND PARAMETER TO VARY IS RE_PHI0
C            4 : SECOND PARAMETER TO VARY IS RE_P0
C            5 : SECOND PARAMETER TO VARY IS RE_LAMBDA0
C     NRE1 > 0 : DIMENSION OF FIRST PARAMETER 
C     NRE2 > 0 : DIMENSION OF SECOND PARAMETER 
C     REQUIREMENTS: 1) KRE1.NE.KRE2; 2) NRE1*NRE2*2=NREORBIT
C   KRE_STEP >0 : LSODE OUTPUT AT MULTIPLE OF KRE_STEP TIME STEPS
C            =-1: STORE POINCARE PLOT DATA ON PHI=CONST PLANE
C            =-2: STORE RE LOSS DATA FOR EACH ARTICLE IN INDIVIDUAL FILE
C            =-3: STORE POINCARE PLOT DATA ON CHI=CONST PLANE
C   KRE_STEP_MAX: MAXIMUM TIME STEPS FOR REORBIT TRACING
C   KRE_TRACE>0 : OUTPUT PARTICLE TRACES FOR PARTICLE NUMBER K=1,KRE_TRACE  
